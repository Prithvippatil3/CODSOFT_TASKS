
import json
import os

FILE_NAME = "contacts.json"


def load_contacts():
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError):
            print("Warning: Could not read saved contacts.")
    return {}


def save_contacts(contacts):
    try:
        with open(FILE_NAME, "w") as file:
            json.dump(contacts, file, indent=4)
        return True
    except OSError:
        print("Error: Could not save contacts.")
        return False


def add_contact(contacts):
    name = input("Enter name: ").strip()

    if not name:
        print("Name cannot be empty.")
        return

    if name in contacts:
        print("A contact with this name already exists.")
        return

    phone = input("Enter phone number: ").strip()
    email = input("Enter email: ").strip()
    address = input("Enter address: ").strip()

    contacts[name] = {
        "phone": phone,
        "email": email,
        "address": address
    }

    if save_contacts(contacts):
        print("Contact added successfully!")
    else:
        contacts.pop(name, None)


def view_contacts(contacts):
    if not contacts:
        print("No contacts found.")
        return

    print("\n========== CONTACT LIST ==========")

    for name, details in contacts.items():
        print("\nName:", name)
        print("Phone:", details["phone"])
        print("Email:", details["email"])
        print("Address:", details["address"])


def search_contact(contacts):
    query = input("Enter name or phone number: ").strip().lower()

    if not query:
        print("Search cannot be empty.")
        return

    found = False

    for name, details in contacts.items():
        if (
            query in name.lower()
            or query in details["phone"].lower()
        ):
            print("\nName:", name)
            print("Phone:", details["phone"])
            print("Email:", details["email"])
            print("Address:", details["address"])
            found = True

    if not found:
        print("Contact not found.")


def update_contact(contacts):
    name = input("Enter the exact name to update: ").strip()

    if name not in contacts:
        print("Contact not found.")
        return

    details = contacts[name]

    print("Press Enter to keep the current value.")

    phone = input(f"Phone [{details['phone']}]: ").strip()
    email = input(f"Email [{details['email']}]: ").strip()
    address = input(f"Address [{details['address']}]: ").strip()

    old_details = details.copy()

    if phone:
        details["phone"] = phone
    if email:
        details["email"] = email
    if address:
        details["address"] = address

    if save_contacts(contacts):
        print("Contact updated successfully!")
    else:
        contacts[name] = old_details


def delete_contact(contacts):
    name = input("Enter the exact name to delete: ").strip()

    if name not in contacts:
        print("Contact not found.")
        return

    confirmation = input(
        f"Delete contact '{name}'? (yes/no): "
    ).strip().lower()

    if confirmation not in ("yes", "y"):
        print("Deletion cancelled.")
        return

    deleted_contact = contacts.pop(name)

    if save_contacts(contacts):
        print("Contact deleted successfully!")
    else:
        contacts[name] = deleted_contact


def main():
    contacts = load_contacts()

    while True:
        print("\n========== CONTACT BOOK ==========")
        print("1. Add Contact")
        print("2. View Contacts")
        print("3. Search Contact")
        print("4. Update Contact")
        print("5. Delete Contact")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ").strip()

        if choice == "1":
            add_contact(contacts)
        elif choice == "2":
            view_contacts(contacts)
        elif choice == "3":
            search_contact(contacts)
        elif choice == "4":
            update_contact(contacts)
        elif choice == "5":
            delete_contact(contacts)
        elif choice == "6":
            print("Thank you for using Contact Book!")
            break
        else:
            print("Invalid choice! Please enter a number from 1 to 6.")


if __name__ == "__main__":
    main()
